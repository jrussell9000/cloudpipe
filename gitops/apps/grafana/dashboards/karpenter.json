      "description": "Empty whenever no Karpenter nodes exist — see the note in the panel above. This series comes from node labels, which only Karpenter-provisioned nodes carry."
    },
    {
      "id": 10,
      "type": "timeseries",
      "title": "Nodes removed (per hour)",
      "gridPos": {
        "x": 12,
        "y": 15,
        "w": 12,
        "h": 7
      },
