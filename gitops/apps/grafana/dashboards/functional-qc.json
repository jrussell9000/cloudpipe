    {
      "id": 7,
      "type": "table",
      "title": "Runs to review — highest motion first",
      "gridPos": {
        "x": 0,
        "y": 45,
        "w": 24,
        "h": 10
      },
      "datasource": {
        "uid": "cloudpipe-athena",
        "type": "grafana-athena-datasource"
      },
      "targets": [
        {
          "refId": "A",
          "queryType": "table",
          "format": 1,
          "connectionArgs": {
            "catalog": "__default",
            "database": "__default",
            "region": "__default"
          },
          "rawSQL": "WITH d AS (SELECT *, ROW_NUMBER() OVER (PARTITION BY subject, session, task, run ORDER BY completed_at DESC) AS rn FROM cloudpipe_metrics.func_preproc WHERE ('${subject}' = 'All' OR subject = '${subject}') AND ('${session}' = 'All' OR session = '${session}') AND ('${task}' = 'All' OR task = '${task}') AND from_iso8601_timestamp(completed_at) BETWEEN $__timeFrom() AND $__timeTo() AND CAST(dt AS DATE) BETWEEN CAST($__timeFrom() AS DATE) AND CAST($__timeTo() AS DATE)) SELECT subject, session, task, run, ROUND(mean_fd, 3) AS mean_fd, ROUND(max_fd, 3) AS max_fd, ROUND(pct_fd_above_0p5, 1) AS pct_fd_above_0p5, ROUND(mean_dvars, 2) AS mean_dvars, ROUND(tsnr_median, 1) AS tsnr_median, n_frames, completed_at FROM d WHERE rn = 1 AND mean_fd > 0.5 ORDER BY mean_fd DESC LIMIT 100"
        }
      ],
      "description": "Runs whose mean FD exceeds 0.5 mm. Empty is the good outcome. Sorted worst-first and capped at 100 — if exactly 100 rows appear, compare against 'Runs QC'd' in the header, because the tail is being truncated. tSNR is included so you can tell a merely restless run from one that also carries no usable signal.",
      "fieldConfig": {
        "defaults": {},
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "mean_fd"
            },
            "properties": [
              {
                "id": "unit",
                "value": "suffix: mm"
              },
              {
                "id": "decimals",
                "value": 3
              }
            ]
          },
