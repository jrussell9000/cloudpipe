{
  "uid": "cloudpipe-funcqc",
  "title": "CloudPipe — Functional QC",
  "description": "BOLD run quality: head motion, signal-to-noise, confound regressors, and runtime. One row per BOLD run (subject x session x task x run), deduplicated to the most recent attempt per run.",
  "tags": [
    "cloudpipe",
    "qc",
    "functional"
  ],
  "links": [
    {
      "type": "dashboards",
      "title": "CloudPipe dashboards",
