            "matcher": {
              "id": "byName",
              "options": "max_fd"
            },
            "properties": [
              {
                "id": "unit",
                "value": "suffix: mm"
              },
              {
                "id": "decimals",
                "value": 3
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "pct_fd_above_0p5"
            },
            "properties": [
              {
                "id": "unit",
                "value": "percent"
              },
              {
                "id": "decimals",
                "value": 1
              }
            ]
          },
