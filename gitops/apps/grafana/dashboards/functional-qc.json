          "rawSQL": "WITH d AS (SELECT *, ROW_NUMBER() OVER (PARTITION BY subject, session, task, run ORDER BY completed_at DESC) AS rn FROM cloudpipe_metrics.func_preproc WHERE ('${subject}' = 'All' OR subject = '${subject}') AND ('${session}' = 'All' OR session = '${session}') AND ('${task}' = 'All' OR task = '${task}') AND from_iso8601_timestamp(completed_at) BETWEEN $__timeFrom() AND $__timeTo() AND CAST(dt AS DATE) BETWEEN CAST($__timeFrom() AS DATE) AND CAST($__timeTo() AS DATE)) SELECT mean_fd, mean_dvars, tsnr_median, mean_global_signal FROM d WHERE rn = 1"
