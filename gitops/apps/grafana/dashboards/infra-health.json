          "expr": "sum(rate(apiserver_request_total{code=\"429\"}[5m]))",
          "legendFormat": "429 throttled"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "custom": {
            "thresholdsStyle": {
              "mode": "dashed"
