    {
      "id": 100,
      "type": "row",
      "title": "🔎 What failed",
      "collapsed": false,
      "gridPos": {
        "x": 0,
        "y": 5,
        "w": 24,
        "h": 1
      },
      "panels": []
    },
    {
      "id": 4,
      "type": "stat",
      "title": "Most common cause",
      "gridPos": {
        "x": 0,
        "y": 6,
        "w": 6,
        "h": 5
      },
      "datasource": {
        "uid": "cloudpipe-athena",
        "type": "grafana-athena-datasource"
      },
      "targets": [
        {
          "refId": "A",
          "queryType": "table",
          "format": 1,
          "connectionArgs": {
            "catalog": "__default",
            "database": "__default",
            "region": "__default"
          },
          "rawSQL": "SELECT failure_category FROM cloudpipe_metrics.step_outcomes WHERE status = 'failed' AND failure_category <> '' AND from_iso8601_timestamp(recorded_at) BETWEEN $__timeFrom() AND $__timeTo() AND CAST(dt AS DATE) BETWEEN CAST($__timeFrom() AS DATE) AND CAST($__timeTo() AS DATE) GROUP BY failure_category ORDER BY COUNT(*) DESC LIMIT 1"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "fixed",
            "fixedColor": "orange"
          },
          "mappings": [
            {
              "type": "value",
              "options": {
                "infrastructure": {
                  "color": "yellow",
                  "index": 0
                },
                "algorithm": {
                  "color": "red",
                  "index": 1
                },
                "data": {
                  "color": "orange",
                  "index": 2
                },
                "dependency": {
                  "color": "purple",
                  "index": 3
                },
                "unknown": {
                  "color": "gray",
                  "index": 4
                }
              }
            }
          ]
        }
      },
      "description": "The failure_category appearing most often in range. Start here, then filter the table below to that category.",
      "options": {
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "value",
        "justifyMode": "center"
      }
    },
    {
      "id": 5,
      "type": "table",
      "title": "Every failed & skipped step",
      "gridPos": {
        "x": 6,
        "y": 6,
        "w": 18,
        "h": 12
      },
      "datasource": {
        "uid": "cloudpipe-athena",
        "type": "grafana-athena-datasource"
      },
      "targets": [
        {
          "refId": "A",
          "queryType": "table",
          "format": 1,
          "connectionArgs": {
            "catalog": "__default",
            "database": "__default",
            "region": "__default"
          },
          "rawSQL": "SELECT recorded_at, subject, session, task, run, step, status, failure_category, failure_reason, upstream_failed_step FROM cloudpipe_metrics.step_outcomes WHERE status IN ('failed', 'skipped') AND from_iso8601_timestamp(recorded_at) BETWEEN $__timeFrom() AND $__timeTo() AND CAST(dt AS DATE) BETWEEN CAST($__timeFrom() AS DATE) AND CAST($__timeTo() AS DATE) ORDER BY recorded_at DESC"
        }
      ],
      "options": {
        "cellHeight": "auto",
        "sortBy": [
          {
            "displayName": "recorded_at",
            "desc": true
          }
        ]
      },
      "fieldConfig": {
        "defaults": {},
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "status"
            },
            "properties": [
              {
                "id": "mappings",
                "value": [
                  {
                    "type": "value",
                    "options": {
                      "failed": {
                        "text": "failed",
                        "color": "red",
                        "index": 0
                      },
                      "skipped": {
                        "text": "skipped",
                        "color": "orange",
                        "index": 1
                      }
                    }
                  }
                ]
              },
              {
                "id": "custom.cellOptions",
                "value": {
                  "type": "color-background",
                  "mode": "basic"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "failure_category"
            },
            "properties": [
              {
                "id": "mappings",
                "value": [
                  {
                    "type": "value",
                    "options": {
                      "infrastructure": {
                        "text": "infrastructure",
                        "color": "yellow",
                        "index": 0
                      },
                      "algorithm": {
                        "text": "algorithm",
                        "color": "red",
                        "index": 1
                      },
                      "data": {
                        "text": "data",
                        "color": "orange",
                        "index": 2
                      },
                      "dependency": {
                        "text": "dependency",
                        "color": "purple",
                        "index": 3
                      },
                      "unknown": {
                        "text": "unknown",
                        "color": "gray",
                        "index": 4
                      }
                    }
                  }
                ]
              },
              {
                "id": "custom.cellOptions",
                "value": {
                  "type": "color-background",
                  "mode": "basic"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "failure_reason"
            },
            "properties": [
              {
                "id": "custom.cellOptions",
                "value": {
                  "wrapText": true
                }
              }
            ]
          }
        ]
      },
      "description": "Most recent first. Sort or filter by `status` to separate the two — they are very different things. When `upstream_failed_step` is populated, this step is a casualty rather than a cause."
    }
  ]
}
