#!/usr/bin/env bash
# Globus Connect Server host — the only thing Terraform tells the instance.
#
# Everything this host does is in its AMI (packer/globus-gcs/): Globus Connect
# Server at a pinned version, the Envoy listener mechanism, the reconcile
# package, and the units that register the node on every boot. The one thing the
# image cannot know is which deployment it belongs to, so that is the one thing
# written here (D11).
#
# What used to be here, and where it went:
#   * apt installs of globus-connect-server54 and awscli -> the AMI. On 24.04
#     the awscli line would have failed outright: Ubuntu publishes no such
#     package for noble, and jammy's is AWS CLI v1.
#   * the `sed 's|http://|https://|' /etc/apt/sources.list` HTTPS rewrite -> the
#     AMI, against /etc/apt/sources.list.d/ubuntu.sources. On 24.04 the old line
#     edited a file apt no longer reads: a silent no-op.
#   * gcs-finalize-setup, a ~100-line heredoc that created the endpoint, the
#     storage gateway and the collection on a host somebody had SSH'd into ->
#     `pixi run globus bootstrap-endpoint` and `globus configure`, which run from
#     a workstation, are tested, and record what they did.
#   * gcs-auto-reregister -> /usr/local/sbin/cloudpipe-gcs-boot in the AMI, where
#     it can be read, tested and shellchecked.
#   * a `cloudpipe` uid-997 system user and a gcs-identity-map.py that nothing
#     referenced -> deleted. Both belonged to the POSIX/Mountpoint staging path
#     that ADR 001 removed; no storage gateway here is created with
#     --identity-mapping, and nothing in the repository read either of them.
#
# This script is intentionally short enough to read in full. If it grows, that is
# a sign something deployment-independent is being done here instead of in the
# AMI.

set -euo pipefail
exec > >(tee /var/log/cloudpipe-gcs-user-data.log | logger -t cloudpipe-gcs-user-data) 2>&1

install -d -m 755 /etc/cloudpipe

# Mode 644, and no secret in it: these two values say where to look, not what
# will be found there. The endpoint id, the deployment key and the service
# credentials all stay in SSM and are fetched by the instance role.
#
# The heredoc delimiter is quoted so the shell expands nothing in the body. The
# two values are still substituted, because that happens in Terraform's
# templatefile() before this text is ever a script.
cat > /etc/cloudpipe/gcs.env <<'ENV'
# Written by Terraform (module globus, user_data.sh.tftpl). Do not edit by hand:
# this file is rewritten when the instance is replaced, and an edit here would be
# lost. Read by cloudpipe-gcs-boot and by the reconcile.
CLOUDPIPE_SSM_PREFIX='${ssm_prefix}'
AWS_REGION='${region}'
ENV
chmod 644 /etc/cloudpipe/gcs.env

# `restart`, not `start`. cloudpipe-gcs-boot.service is enabled in the AMI, so it
# has ALREADY run this boot — before cloud-init reached user_data, finding no
# env file and correctly doing nothing. It is Type=oneshot with
# RemainAfterExit=yes, which leaves it "active (exited)", and `systemctl start`
# on an active unit is a no-op. A fresh instance would then sit unregistered
# until somebody rebooted it.
if [ -x /usr/local/sbin/cloudpipe-gcs-boot ]; then
  systemctl restart cloudpipe-gcs-boot.service
else
  # Launched from an image that is not the GCS AMI. Nothing here can fix that,
  # so say so once, plainly, in the console log a person actually reads.
  echo "ERROR: /usr/local/sbin/cloudpipe-gcs-boot is missing — this instance was" \
    "not launched from the AMI built by packer/globus-gcs/. It will never" \
    "register as a Globus node. Check globus_ami_id in terraform/globus.tf."
  exit 1
fi
